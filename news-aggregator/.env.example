# Environment variables for the news-aggregator frontend
# IMPORTANT: Frontend apps bundle and expose any variables prefixed with VITE_ to client-side code.
# If you put API keys directly in a Vite frontend environment, they will be visible in the browser and
# can be extracted by anyone using the app. For public API keys (some news APIs offer limited public keys)
# this may be acceptable for development. For private keys or production, you should proxy requests
# through a server-side component that keeps the keys secret.

# Example (for Vite, prefix with VITE_ to expose to client code):
VITE_NEWSAPI_KEY=
VITE_GUARDIAN_KEY=
VITE_NYT_KEY=

# Optional: override base URLs
VITE_NEWSAPI_BASE_URL=https://newsapi.org/v2
VITE_GUARDIAN_BASE_URL=https://content.guardianapis.com
VITE_NYT_BASE_URL=https://api.nytimes.com/svc/search/v2
